# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pdb

# Python package / build outputs
*.egg
*.egg-info/
.eggs/
dist/
build/
site/
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment
venv/
env/
ENV/
.venv/

# Environment variables
.env
.env.*
!.env.example

# Runtime outputs
alarm_log.jsonl
alarm_records.db
alarm_results/
*.db
*.sqlite
*.sqlite3

# YOLO / training outputs
runs/
outputs/
results/

# Dataset / local data
data/
dataset/
datasets/

